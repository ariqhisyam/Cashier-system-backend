// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id              String    @id @default(uuid())
  name            String
  price           Int
  stock           Int       @default(0)
  rawMaterialCost Int       @default(0)
  imageUrl        String    @default("/matcha-latte.jpg")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([name])
  @@index([isActive])
  @@map("products")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum Role {
  ADMIN
  KARYAWAN
}

model User {
  id            String    @id @default(uuid())
  name          String
  key           String    @unique
  role          Role      @default(KARYAWAN)
  monthlySalary Int?      @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([name])
  @@index([role])
  @@index([isActive])
  @@map("users")
}
