# Database Connection (Prisma via Supabase Pooler IPv4 - Region: ap-northeast-2)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Supabase Object Storage Configuration (S3 Protocol)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_STORAGE_BUCKET="Cashier-system-img"
S3_ENDPOINT="https://your-project-ref.supabase.co/storage/v1/s3"
S3_REGION="ap-northeast-2"
S3_ACCESS_KEY_ID="your_s3_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_secret_access_key"

# App Port & Security
PORT=3001
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
